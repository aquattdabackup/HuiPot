# HuiPot Goal Pool — environment variable example
# Copy to .env and fill in real values. Never commit .env.

# Deployed HuiPotGoalPool contract address on Arc Testnet (chain ID 5042002).
VITE_HUIPOT_ADDRESS=0x0000000000000000000000000000000000000000

# WalletConnect Project ID — obtain from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Arc Studio RPC proxy (set automatically in Studio sandbox; optional outside)
# RPC_PROXY_BASE_URL=
# RPC_PROXY_TOKEN=
# RPC_PROXY_CHAINS=
